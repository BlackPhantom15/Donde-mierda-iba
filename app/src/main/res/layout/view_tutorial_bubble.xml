<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_tutorial_bubble"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/txtTutorialStepCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.04"
        android:textAllCaps="true"
        android:textColor="@color/accent_cyan"
        android:textSize="10.5sp"
        tools:text="PASO 2 DE 7" />

    <TextView
        android:id="@+id/txtTutorialTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/text_primary"
        android:textSize="16.5sp"
        tools:text="Acá separás el bardo" />

    <TextView
        android:id="@+id/txtTutorialBody"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxWidth="270dp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/text_secondary"
        android:textSize="13.5sp"
        tools:text="Series, películas y videos, cada uno en su cajón. Nada de mezclar todo como en un asado improvisado." />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnTutorialSkip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="10dp"
            android:text="@string/tutorial_skip"
            android:textColor="@color/text_secondary"
            android:fontFamily="sans-serif-medium"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnTutorialNext"
            style="@style/Widget.DMI.AppleButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="@string/tutorial_next"
            android:textSize="13.5sp" />

    </LinearLayout>

</LinearLayout>
