<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_dialog">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tmdb_key_title"
            android:textAppearance="@style/TextAppearance.DMI.Title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/tmdb_key_explain"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnTmdbGetKey"
            style="@style/Widget.DMI.AppleButton.Ghost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/tmdb_key_get" />

        <EditText
            android:id="@+id/edtTmdbKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_glass_input"
            android:hint="@string/tmdb_key_hint"
            android:importantForAutofill="no"
            android:inputType="textNoSuggestions"
            android:maxLines="2"
            android:padding="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtTmdbStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/accent_orange"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnTmdbSave"
            style="@style/Widget.DMI.AppleButton.Ghost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/tmdb_key_save" />

        <Button
            android:id="@+id/btnTmdbRemove"
            style="@style/Widget.DMI.AppleButton.Ghost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/tmdb_key_remove" />

        <Button
            android:id="@+id/btnTmdbClose"
            style="@style/Widget.DMI.AppleButton.Ghost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/close" />
    </LinearLayout>
</ScrollView>
