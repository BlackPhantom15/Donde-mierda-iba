<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/completeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D90B0E10"
    android:clickable="true"
    android:focusable="true">

    <View
        android:id="@+id/glowRing"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_glow_ring" />

    <LinearLayout
        android:id="@+id/completeCard"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_celebration_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="26dp"
        android:paddingEnd="22dp"
        android:paddingBottom="24dp">

        <FrameLayout
            android:layout_width="150dp"
            android:layout_height="210dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/posterCard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="6dp"
                app:cardBackgroundColor="#1B202B"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <ImageView
                    android:id="@+id/completePoster"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_image_placeholder" />
            </androidx.cardview.widget.CardView>

            <ImageView
                android:id="@+id/completeBadge"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_check_badge"
                android:padding="10dp"
                android:src="@drawable/ic_check"
                android:tint="#0E1A12"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:id="@+id/completeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="serif"
            android:gravity="center"
            android:text="@string/series_completed_title"
            android:textColor="@color/completed_green"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/completeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Breaking Bad" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/series_completed_sub"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

</FrameLayout>
