<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_sheet"
    android:orientation="vertical"
    android:padding="22dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#40FFFFFF" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/backup_menu_title"
        android:textAppearance="@style/TextAppearance.DMI.Title" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/backup_menu_subtitle"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btnExport"
        style="@style/Widget.DMI.AppleButton.Ghost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:drawableStart="@drawable/ic_share"
        android:drawablePadding="10dp"
        android:gravity="center_vertical|start"
        android:text="@string/backup_export_action" />

    <Button
        android:id="@+id/btnImport"
        style="@style/Widget.DMI.AppleButton.Ghost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:drawableStart="@drawable/ic_import"
        android:drawablePadding="10dp"
        android:gravity="center_vertical|start"
        android:text="@string/backup_import_action" />

    <Button
        android:id="@+id/btnReplayTutorial"
        style="@style/Widget.DMI.AppleButton.Ghost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:drawableStart="@drawable/ic_help"
        android:drawablePadding="10dp"
        android:gravity="center_vertical|start"
        android:text="@string/tutorial_replay" />

    <Button
        android:id="@+id/btnAboutApp"
        style="@style/Widget.DMI.AppleButton.Ghost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:drawableStart="@drawable/ic_info"
        android:drawablePadding="10dp"
        android:gravity="center_vertical|start"
        android:text="@string/about_menu_action" />

    <Button
        android:id="@+id/btnTmdbKey"
        style="@style/Widget.DMI.AppleButton.Ghost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:drawableStart="@drawable/ic_where_to_watch"
        android:drawablePadding="10dp"
        android:gravity="center_vertical|start"
        android:text="@string/tmdb_key_menu_action" />

    <Button
        android:id="@+id/btnTerms"
        style="@style/Widget.DMI.AppleButton.Ghost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:drawableStart="@drawable/ic_info"
        android:drawablePadding="10dp"
        android:gravity="center_vertical|start"
        android:text="@string/terms_menu_action" />

</LinearLayout>
