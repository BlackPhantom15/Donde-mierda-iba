<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Encabezado editorial: logo, eyebrow y título en dos líneas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="22dp"
            android:paddingEnd="20dp">

            <ImageView
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_logo_tile"
                android:padding="7dp"
                android:src="@drawable/ic_logo"
                android:contentDescription="@string/app_name" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:lineSpacingMultiplier="0.92"
                    android:text="@string/main_title"
                    android:textColor="@color/text_primary"
                    android:textSize="29sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp">

                <ImageButton
                    android:id="@+id/btnNotifications"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_tile"
                    android:padding="11dp"
                    android:src="@drawable/ic_bell"
                    android:contentDescription="@string/notif_history_title" />

                <View
                    android:id="@+id/bellBadge"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="3dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/bg_badge_dot"
                    android:visibility="gone" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/btnBackupMenu"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_tile"
                android:padding="11dp"
                android:src="@drawable/ic_more_vert"
                android:contentDescription="@string/backup_menu_title" />

        </LinearLayout>

        <!-- Buscador + acciones de lista -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/searchContainer"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:alpha="0.6"
                    android:src="@drawable/ic_search" />

                <EditText
                    android:id="@+id/editSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="15sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnCheckUpdates"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_tile"
                android:padding="12dp"
                android:src="@drawable/ic_refresh"
                android:contentDescription="@string/check_updates_now" />

            <ImageButton
                android:id="@+id/btnToggleView"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_tile"
                android:padding="12dp"
                android:src="@drawable/ic_grid"
                android:contentDescription="@string/view_grid" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- Botón de agregar, flotando arriba de la barra -->
    <Button
        android:id="@+id/btnAdd"
        style="@style/Widget.DMI.AppleButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="94dp"
        android:elevation="10dp"
        android:text="@string/add_serie" />

    <!-- Barra inferior flotante: Series / Películas / Videos -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_nav_bar"
        android:elevation="12dp"
        app:tabBackground="@android:color/transparent"
        app:tabGravity="fill"
        app:tabIconTint="@color/tab_item_color"
        app:tabIndicator="@drawable/bg_tab_indicator"
        app:tabIndicatorAnimationMode="elastic"
        app:tabIndicatorColor="@color/tab_pill"
        app:tabIndicatorFullWidth="true"
        app:tabIndicatorGravity="stretch"
        app:tabInlineLabel="true"
        app:tabMode="fixed"
        app:tabRippleColor="@null"
        app:tabSelectedTextColor="@color/accent_orange_light"
        app:tabTextAppearance="@style/TextAppearance.DMI.Tab"
        app:tabTextColor="@color/text_muted">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:icon="@drawable/ic_tab_series"
            android:text="@string/tab_series" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:icon="@drawable/ic_tab_movie"
            android:text="@string/tab_peliculas" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:icon="@drawable/ic_tab_video"
            android:text="@string/tab_videos" />

    </com.google.android.material.tabs.TabLayout>

</FrameLayout>
