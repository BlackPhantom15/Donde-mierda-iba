<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_item_background"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="9dp"
    android:paddingBottom="12dp">

    <!-- Fila 1: miniatura con aro + nombre + progreso. Tocarla abre el editor completo. -->
    <LinearLayout
        android:id="@+id/widgetRowContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_thumb_ring"
            android:padding="2dp">

            <ImageView
                android:id="@+id/widgetThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/widgetDot"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_dot" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="11dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widgetItemName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="#F8F7FF"
                android:textSize="13.5sp"
                tools:text="Breaking Bad" />

            <TextView
                android:id="@+id/widgetItemMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#B6B0D6"
                android:textSize="11sp"
                tools:text="T2 · C05 · 34 min" />

        </LinearLayout>

    </LinearLayout>

    <!-- Fila 2: steppers rápidos, sin tener que abrir la app. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Temporada +1 -->
        <LinearLayout
            android:id="@+id/widgetBtnSeasonPlus"
            android:layout_width="0dp"
            android:layout_height="27dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1.15"
            android:background="@drawable/widget_btn_season"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:src="@drawable/ic_widget_season" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/widget_stepper_season"
                android:textColor="#DDD6FE"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Capítulo -1 / +1 (icono solo, es la acción principal) -->
        <ImageView
            android:id="@+id/widgetBtnMinus"
            android:layout_width="0dp"
            android:layout_height="27dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="0.75"
            android:background="@drawable/widget_btn_minus"
            android:padding="8dp"
            android:src="@drawable/ic_widget_minus" />

        <ImageView
            android:id="@+id/widgetBtnPlus"
            android:layout_width="0dp"
            android:layout_height="27dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="0.75"
            android:background="@drawable/widget_btn_plus"
            android:padding="7dp"
            android:src="@drawable/ic_widget_plus" />

        <!-- Minuto +5 -->
        <LinearLayout
            android:id="@+id/widgetBtnMinutePlus"
            android:layout_width="0dp"
            android:layout_height="27dp"
            android:layout_weight="1.15"
            android:background="@drawable/widget_btn_minute"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:src="@drawable/ic_widget_minute" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/widget_stepper_minute"
                android:textColor="#A5F3FC"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
