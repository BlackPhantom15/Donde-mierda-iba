<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="#40FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/imgPreviewContainer"
                android:layout_width="64dp"
                android:layout_height="64dp">

                <ImageView
                    android:id="@+id/imgPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_glass_input"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_image_placeholder" />

                <TextView
                    android:id="@+id/txtPlatformInitial"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="Y"
                    xmlns:tools="http://schemas.android.com/tools" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_button_apple_normal"
                    android:padding="4dp"
                    android:src="@drawable/ic_camera" />

            </FrameLayout>

            <EditText
                android:id="@+id/txtName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="sans-serif-medium"
                android:hint="@string/field_name"
                android:inputType="textCapSentences"
                android:maxLines="2"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="17sp" />

            <ImageButton
                android:id="@+id/btnQuickConfirm"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_button_apple_normal"
                android:padding="9dp"
                android:src="@drawable/ic_check"
                android:contentDescription="@string/update" />

            <ImageButton
                android:id="@+id/btnPinWidget"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_glass_input"
                android:padding="9dp"
                android:src="@drawable/ic_pin_outline"
                android:contentDescription="@string/widget_pin_added"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btnDelete"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_glass_input"
                android:padding="9dp"
                android:src="@drawable/ic_delete" />

        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupPlatform"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:visibility="gone"
            app:singleSelection="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/edit_progress_title"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Grupo de "candados": temporada / capítulo / duración -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_wheel_container"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:id="@+id/rowSeasonEpisode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/columnSeason"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtSeasonLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/field_season"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />

                    <NumberPicker
                        android:id="@+id/pickerSeason"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <View
                    android:id="@+id/dividerSeasonEpisode"
                    android:layout_width="1dp"
                    android:layout_height="40dp"
                    android:background="@color/glass_stroke" />

                <LinearLayout
                    android:id="@+id/columnEpisode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtEpisodeLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/field_episode"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />

                    <NumberPicker
                        android:id="@+id/pickerEpisode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

            </LinearLayout>

            <View
                android:id="@+id/dividerEpisodeMinute"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@color/glass_stroke"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/rowDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/columnHour"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/field_hours"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />

                    <NumberPicker
                        android:id="@+id/pickerHour"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text=":"
                    android:textColor="@color/text_muted"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/columnMinute"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/field_minute"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />

                    <NumberPicker
                        android:id="@+id/pickerMinute"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Calificación con estrellas -->
        <LinearLayout
            android:id="@+id/ratingSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtRatingLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/rating_label_movie"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/star1"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@android:color/transparent"
                    android:padding="4dp"
                    android:src="@drawable/ic_star_outline"
                    android:contentDescription="@string/rating_star_n" />

                <ImageButton
                    android:id="@+id/star2"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@android:color/transparent"
                    android:padding="4dp"
                    android:src="@drawable/ic_star_outline"
                    android:contentDescription="@string/rating_star_n" />

                <ImageButton
                    android:id="@+id/star3"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@android:color/transparent"
                    android:padding="4dp"
                    android:src="@drawable/ic_star_outline"
                    android:contentDescription="@string/rating_star_n" />

                <ImageButton
                    android:id="@+id/star4"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@android:color/transparent"
                    android:padding="4dp"
                    android:src="@drawable/ic_star_outline"
                    android:contentDescription="@string/rating_star_n" />

                <ImageButton
                    android:id="@+id/star5"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@android:color/transparent"
                    android:padding="4dp"
                    android:src="@drawable/ic_star_outline"
                    android:contentDescription="@string/rating_star_n" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtSeasonAverage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textColor="@color/text_muted"
                android:textSize="11.5sp"
                android:visibility="gone"
                tools:text="Promedio T2: 4.3 ⭐ (5 capítulos)"
                xmlns:tools="http://schemas.android.com/tools" />

        </LinearLayout>

        <!-- Marcar como visto completo / dónde ver -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMarkWatched"
                style="@style/Widget.DMI.AppleButton.Ghost"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:drawablePadding="6dp"
                android:drawableStart="@drawable/ic_check"
                android:text="@string/mark_watched_action"
                android:textSize="12.5sp" />

            <Button
                android:id="@+id/btnWhereToWatch"
                style="@style/Widget.DMI.AppleButton.Ghost"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawablePadding="6dp"
                android:drawableStart="@drawable/ic_where_to_watch"
                android:text="@string/where_to_watch_action"
                android:textSize="12.5sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancel"
                style="@style/Widget.DMI.AppleButton.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:text="@string/cancel" />

            <Button
                android:id="@+id/btnUpdate"
                style="@style/Widget.DMI.AppleButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/update" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
