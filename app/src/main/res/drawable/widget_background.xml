<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:type="linear"
                android:angle="115"
                android:startColor="#221F26"
                android:centerColor="#1B191F"
                android:endColor="#121115" />
        </shape>
    </item>
    <!-- brillo diagonal sutil -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:type="linear"
                android:angle="115"
                android:startColor="#1EFFFFFF"
                android:centerColor="#06FFFFFF"
                android:endColor="#00000000"
                android:centerY="0.35" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="#22FFFFFF" />
        </shape>
    </item>
</layer-list>
