<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Sombra: una silueta oscura corrida hacia abajo -->
    <item android:top="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#2E000000" />
        </shape>
    </item>
    <!-- Cuerpo de vidrio -->
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:type="linear"
                android:angle="115"
                android:startColor="#2AFFFFFF"
                android:centerColor="#16FFFFFF"
                android:endColor="#0DFFFFFF" />
        </shape>
    </item>
    <!-- Borde con brillo -->
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#3AFFFFFF" />
        </shape>
    </item>
</layer-list>
