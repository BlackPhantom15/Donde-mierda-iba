<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="@color/neu_glow_orange"
                android:centerColor="@color/accent_orange"
                android:endColor="@color/accent_orange_dark" />
        </shape>
    </item>
    <!-- borde con brillo -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/neu_glow_ring" />
        </shape>
    </item>
    <item android:bottom="14dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#45FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
