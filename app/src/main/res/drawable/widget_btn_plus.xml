<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#A78BFA"
                android:centerColor="#8B5CF6"
                android:endColor="#6D28D9" />
        </shape>
    </item>
    <item android:bottom="14dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#45FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
