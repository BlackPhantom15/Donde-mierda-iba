<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- sombra oscura (inferior-derecha) -->
    <item android:top="3dp" android:left="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="@color/neu_shadow_dark" />
        </shape>
    </item>
    <!-- sombra clara (superior-izquierda), simula el reflejo de luz -->
    <item android:bottom="3dp" android:right="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="@color/neu_shadow_light" />
        </shape>
    </item>
    <!-- cara principal -->
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="25dp" />
            <gradient android:type="linear" android:angle="135" android:startColor="@color/neu_base_hi" android:endColor="@color/neu_base" />
        </shape>
    </item>
</layer-list>
