<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- sombra oscura sutil -->
    <item android:top="4dp" android:left="4dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="28dp" android:topRightRadius="28dp" />
            <solid android:color="@color/neu_shadow_dark" />
        </shape>
    </item>
    <!-- cuerpo translúcido (deja intuir lo que hay detrás, efecto vidrio) -->
    <item android:bottom="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="27dp" android:topRightRadius="27dp" />
            <solid android:color="#D0201E25" />
        </shape>
    </item>
    <!-- brillo diagonal, como un reflejo sobre el vidrio -->
    <item android:bottom="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="27dp" android:topRightRadius="27dp" />
            <gradient
                android:type="linear"
                android:angle="115"
                android:startColor="#26FFFFFF"
                android:centerColor="#00FFFFFF"
                android:endColor="#00000000" />
        </shape>
    </item>
    <!-- borde de vidrio -->
    <item android:bottom="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="27dp" android:topRightRadius="27dp" />
            <stroke android:width="1dp" android:color="#40FFFFFF" />
        </shape>
    </item>
</layer-list>
