<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="@color/accent_orange_light"
                android:centerColor="@color/accent_orange"
                android:endColor="@color/accent_orange_dark" />
        </shape>
    </item>
    <item
        android:top="2dp"
        android:left="2dp"
        android:right="12dp"
        android:bottom="15dp">
        <shape android:shape="oval">
            <solid android:color="#3AFFFFFF" />
        </shape>
    </item>
</layer-list>
