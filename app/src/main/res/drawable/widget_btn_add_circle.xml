<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="20dp"
                android:startColor="@color/neu_glow_orange"
                android:centerColor="@color/accent_orange"
                android:endColor="@color/accent_orange_dark" />
        </shape>
    </item>
    <!-- anillo de luz -->
    <item>
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="@color/neu_glow_ring" />
        </shape>
    </item>
    <item
        android:top="2dp"
        android:left="2dp"
        android:right="12dp"
        android:bottom="15dp">
        <shape android:shape="oval">
            <solid android:color="#3AFFFFFF" />
        </shape>
    </item>
</layer-list>
